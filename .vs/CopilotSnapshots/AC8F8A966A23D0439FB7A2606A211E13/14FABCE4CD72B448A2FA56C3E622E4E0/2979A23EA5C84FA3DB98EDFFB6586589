│   │   └── main.tsx         # Entry point
│   ├── package.json
│   ├── tsconfig.json
│   └── vite.config.ts
│
├── infrastructure/          # Configuration files
│   ├── janus/              # Janus Gateway config
│   ├── coturn/             # TURN/STUN server config
