services:
  # Coturn TURN/STUN server for NAT traversal
  coturn:
    image: coturn/coturn:latest
    container_name: videortc-coturn
    ports:
      - "3478:3478/udp"
      - "3478:3478/tcp"
      - "10000-10200:10000-10200/udp"
    volumes:
      - ./infrastructure/coturn/turnserver.conf:/etc/coturn/turnserver.conf:ro
    restart: unless-stopped

  # Janus WebRTC Gateway
  janus:
    build:
      context: .
      dockerfile: docker/janus.Dockerfile
    container_name: videortc-janus
    ports:
      - "8088:8088"   # HTTP API
      - "8089:8089"   # WebSocket
      - "8188:8188"   # Admin/Monitor
      - "20000-20200:20000-20200/udp"  # RTP/RTCP
    volumes:
      - ./infrastructure/janus/janus.jcfg:/opt/janus/etc/janus/janus.jcfg:ro
      - ./infrastructure/janus/janus.transport.websockets.jcfg:/opt/janus/etc/janus/janus.transport.websockets.jcfg:ro
      - ./infrastructure/ssl:/opt/janus/certs:ro
    depends_on:
      - coturn
    restart: unless-stopped

  # NGINX reverse proxy
  nginx:
    build:
      context: .
      dockerfile: docker/nginx.Dockerfile
    container_name: videortc-nginx
    ports:
      - "443:443"
      - "80:80"
    volumes:
      - ./infrastructure/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./infrastructure/ssl:/etc/nginx/certs:ro
    depends_on:
      - janus
      - frontend
    restart: unless-stopped

  # React Frontend
  frontend:
    build:
      context: .
      dockerfile: docker/frontend.Dockerfile
    container_name: videortc-frontend
    ports:
      - "5173:5173"
    volumes:
      - ./frontend:/app
      - /app/node_modules
    environment:
      - VITE_JANUS_WS_URL=wss://localhost/janus
      - VITE_TURN_SERVER=turn:localhost:3478
    stdin_open: true
    tty: true
    restart: unless-stopped

networks:
  default:
    name: videortc-network
